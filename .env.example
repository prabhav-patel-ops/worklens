# Copy to .env, then use node --env-file=.env server/index.mjs
PORT=4173
HOST=127.0.0.1
# Set a long random owner token to enable authenticated API operations.
# The website runs in browser-only mode until you connect the backend.
WORKLENS_OWNER_TOKEN=
WORKLENS_ORIGIN=http://localhost:4173
WORKLENS_DATABASE=./data/worklens.db
# 64 hexadecimal characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKLENS_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Backend account/organization discovery continues while the browser is closed.
# Set to 0 to disable. Minimum enabled interval is 1 minute.
WORKLENS_GITHUB_SYNC_MINUTES=15
# Register a GitHub OAuth application for optional verified employee onboarding.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
